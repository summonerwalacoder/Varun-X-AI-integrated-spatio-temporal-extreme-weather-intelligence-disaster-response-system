# VARUN-X environment configuration
#
# The backend reads these on startup. The browser never sees a provider key.
# Copy to `.env` only if you need to override a default; VARUN-X runs without it.

# ----------------------------- server -------------------------------------
# HOST=127.0.0.1
# PORT=8787
# Path to the SQLite database file (default: <cwd>/varun-x-data/varun-x.sqlite)
# VARUNX_DB_PATH=./varun-x-data/varun-x.sqlite
# Set Secure on the session cookie when served over HTTPS
# VARUNX_SECURE_COOKIES=0
# Set to 0 to disable demo account hints and returned OTP/MFA codes
# VARUNX_DEMO_AUTH=1

# --------------------------- live weather ---------------------------------
# Live weather and geocoding are retrieved server-side only.
# Open-Meteo is the default and needs no key: https://open-meteo.com/en/docs
# VARUNX_WEATHER_BASE=https://api.open-meteo.com/v1
# VARUNX_GEOCODE_BASE=https://geocoding-api.open-meteo.com/v1
# VARUNX_REVERSE_GEOCODE_BASE=https://nominatim.openstreetmap.org
# WEATHER_API_KEY=
#
# ------------------------- reanalysis baseline ----------------------------
# The climatology baseline is read from a real ERA5 reanalysis archive, served
# by Open-Meteo, and needs no key. It lags live weather by about six days.
# VARUNX_ARCHIVE_BASE=https://archive-api.open-meteo.com/v1/archive
# Number of past years sampled for the baseline statistics (default 10)
# VARUNX_CLIMATOLOGY_YEARS=10
# Direct IMDAA gridded ingest is NOT connected; VARUN-X reports ERA5 statistics
# as ERA5 and never presents them as IMDAA observations.
# VARUNX_BASELINE_URL=
# VARUNX_EXPOSURE_URL=
# VARUNX_OBSERVATION_URL=

# ------------------------- official alert feed ----------------------------
# Connected by default to a working official feed that needs no key, no signup
# and no approval: the US National Weather Service publishes its CAP 1.2 feed
# openly. That makes the whole ingest chain real out of the box, and the UI
# labels its coverage so a non-Indian warning is never read as an Indian one.
#
# India's competent authorities (IMD, NDMA, SDMA) publish CAP and RSS products
# but no free machine API. Point this at your own authority's feed to replace
# the default; nothing else in VARUN-X changes.
# VARUNX_ALERT_FEED_URL=https://api.weather.gov/alerts/active
#
# Set to off / none / disabled / 0 to switch the channel off entirely.
# VARUNX_ALERT_FEED_URL=off
#
# auto | cap | geojson | rss   (default auto, detects the serialisation)
# VARUNX_ALERT_FEED_FORMAT=auto
#
# Describes what area the feed covers. Shown in the UI next to every warning,
# because a warning is only meaningful against the region that issued it.
# VARUNX_ALERT_FEED_SCOPE=
#
# First token of the CAP sender, matched against these agency codes. Anything
# else inside a configured feed is dropped rather than shown.
# VARUNX_OFFICIAL_AUTHORITIES=IMD,NDMA,SDMA,CWC,INCOIS,NDRF,ATMOD,NWS,NOAA,METEOFRANCE,DWD,UKMO,ECMWF,JMA

# --------------------------- message delivery -----------------------------
# Real transports, each inactive until its credentials exist. A channel with no
# credentials is reported as UNCONFIGURED and is never counted as delivered.

# SMS via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email via an SMTP relay submission endpoint
# SMTP_URL=
# SMTP_FROM=
# SMTP_API_KEY=

# Push via Firebase Cloud Messaging
# FCM_SERVER_KEY=

# --------------------------- intelligence layers --------------------------
# The ensemble, GNN tracker and diffusion refiner are prototype surrogates over
# real forecast input. They are labelled SIMULATION in the UI and their
# provenance reports real: false. Training a validated model needs model
# artifacts and an evaluation set that this repository does not contain.
